# --- Spotify (https://developer.spotify.com/dashboard) ---
SPOTIPY_CLIENT_ID=your_client_id
SPOTIPY_CLIENT_SECRET=your_client_secret
# Must match the Redirect URI in the dashboard EXACTLY. Spotify rejects "localhost";
# use the loopback IP literal.
SPOTIPY_REDIRECT_URI=http://127.0.0.1:8888/callback

# --- MusicBrainz requires an identifying User-Agent (email or URL) ---
LANGSORTER_CONTACT=you@example.com

# --- Optional tuning ---
# LANGSORTER_DB=cache.db
# LANGSORTER_CONFIDENCE=0.75
# LANGSORTER_WORKERS=8
# LANGSORTER_MB_INTERVAL=1.1
# LANGSORTER_LRCLIB_CONCURRENCY=5
